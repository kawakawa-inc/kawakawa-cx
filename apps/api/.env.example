# Database connection string
# For local development, copy this file to .env and update with your values
# In production (DigitalOcean), this is set via environment variables
DATABASE_URL=postgresql://kawa:kawa_dev_password@localhost:5432/kawa_market

# JWT Secret for authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Password reset token expiration in hours (default: 24)
PASSWORD_RESET_EXPIRATION_HOURS=24

# The app's own public origin, used for CSRF origin checks on cookie-authenticated
# mutations. Scheme + host + port, no trailing path.
#
# Leave unset in local dev: the Vite proxy forwards the browser's Host, so the
# fallback Host comparison matches. Set it on every deployed environment —
# behind an ingress the API's Host is an internal name while Origin is public,
# so without this the fallback rejects every mutation.
# APP_ORIGIN=https://kawakawa.cx

# Additional origins permitted to make mutating requests, comma-separated.
# Additive to APP_ORIGIN; for staging, preview apps, or a separate admin host.
# ALLOWED_ORIGINS=https://staging.kawakawa.cx

# Force the `Secure` attribute on the session cookie. Defaults to on only when
# NODE_ENV=production, which is too blunt: an HTTPS staging or preview app
# running a non-production NODE_ENV would silently issue the session cookie
# without `Secure` and allow it to leak over a plaintext downgrade.
#
# Set to `true` on any HTTPS deployment. Set to `false` only to serve over plain
# HTTP, where a `Secure` cookie is dropped by the browser.
# COOKIE_SECURE=true
