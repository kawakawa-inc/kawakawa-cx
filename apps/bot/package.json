    "@kawakawa/services": "workspace:*",
    "@kawakawa/types": "workspace:*",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^4.0.15",
    "tsx": "^4.19.2",
    "typescript": "~5.3.0",
    "vitest": "^4.0.14",
    "knip": "^5.74.0"
  }
}
