{
  "name": "@kawakawa/services",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./discord": {
      "types": "./dist/discord/index.d.ts",
      "import": "./dist/discord/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "import": "./dist/permissions/index.js"
    },
    "./market": {
      "types": "./dist/market/index.d.ts",
      "import": "./dist/market/index.js"
    },
    "./fio": {
      "types": "./dist/fio/index.d.ts",
      "import": "./dist/fio/index.js"
    },
    "./supply": {
      "types": "./dist/supply/index.d.ts",
      "import": "./dist/supply/index.js"
    },
    "./sync-queue": {
      "types": "./dist/sync-queue/index.d.ts",
      "import": "./dist/sync-queue/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js"
    },
    "./user-settings": {
      "types": "./dist/user-settings/index.d.ts",
      "import": "./dist/user-settings/index.js"
    },
    "./sync-state": {
      "types": "./dist/sync-state/index.d.ts",
      "import": "./dist/sync-state/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kawakawa/db": "workspace:*",
    "@kawakawa/types": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "~5.3.0",
    "vitest": "^4.0.14"
  }
}
